{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/schemas/candidate.schema.json",
  "title": "Candidate",
  "type": "object",
  "required": ["id", "sink", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^C-[0-9]{4}$"},
    "sink": {
      "type": "object",
      "required": ["file", "line", "symbol", "type"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "type": {"type": "string"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["origin"],
        "additionalProperties": false,
        "properties": {
          "origin": {"type": "string", "enum": ["semgrep", "llm"]},
          "rule": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "matched_text": {"type": "string"},
    "suspected_vuln_class": {"type": "string"},
    "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
    "impact": {"type": "string", "enum": ["high", "medium", "low"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "chain": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "batch_id": {"type": "string"},
    "priority_hint": {"type": "string", "enum": ["low", "medium", "high"]}
  }
}
