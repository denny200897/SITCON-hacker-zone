{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/schemas/settings.schema.json",
  "title": "Settings",
  "description": "aegis.toml / settings.toml 的機讀契約；金鑰不落此檔（§23-6）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "providers": {
      "type": "object",
      "description": "供應商全由使用者新增；無內建供應商（§3.2）",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "enum": ["anthropic", "openai-compat"]},
          "base_url": {"type": "string", "format": "uri"}
        }
      }
    },
    "models": {
      "type": "object",
      "description": "一律 provider/model-id 形式；無預設值（§3.1）",
      "additionalProperties": false,
      "properties": {
        "recon": {"type": "string", "pattern": "^[a-z0-9-]+/.+$"},
        "reviewer": {"type": "string", "pattern": "^[a-z0-9-]+/.+$"},
        "triager": {"type": "string", "pattern": "^[a-z0-9-]+/.+$"},
        "prover": {"type": "string", "pattern": "^[a-z0-9-]+/.+$"},
        "reporter": {"type": "string", "pattern": "^[a-z0-9-]+/.+$"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_env_fixes_per_finding": {"type": "integer", "minimum": 1, "default": 5},
        "max_harness_fixes_per_finding": {"type": "integer", "minimum": 1, "default": 8},
        "max_hypotheses_per_finding": {"type": "integer", "minimum": 1, "default": 3},
        "max_sandbox_minutes_per_finding": {"type": "integer", "minimum": 1, "default": 10},
        "max_tokens_total": {"type": "integer", "minimum": 1, "description": "預設不設限（BYOK）；保險絲才加（§9.4）"}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_docker": {"type": "boolean", "const": true},
        "run_network": {"type": "string", "enum": ["none", "ssrf-internal"]},
        "build_egress": {"type": "string", "enum": ["pinned_only"]},
        "security_profile": {"type": "string", "const": "default"}
      }
    },
    "sink_packs": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {"type": "string", "default": "zh-TW"}
      }
    }
  }
}