{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/schemas/run_request.schema.json",
  "title": "RunRequest",
  "description": "由 policy compiler 組裝；模型永不直接產生容器請求（不變式 1）",
  "type": "object",
  "required": ["run_id", "kind", "image", "files", "mounts", "cmd", "network", "nonce", "timeout_sec", "caps"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "pattern": "^R-[0-9]{4}$"},
    "kind": {"type": "string", "enum": ["negative", "positive", "exploit"]},
    "image": {
      "type": "string",
      "pattern": "^.*@sha256:[0-9a-f]{64}$",
      "description": "僅接受 digest；可變 tag 拒絕（§7.1/§17.10）"
    },
    "files": {
      "type": "object",
      "description": "witness 檔案與 payload，以 docker cp 注入 /aegis/witness/ 與 /aegis/payload.txt",
      "additionalProperties": {"type": "string"}
    },
    "payload": {"type": "string"},
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "dst", "readonly"],
        "additionalProperties": false,
        "properties": {
          "src": {"type": "string", "enum": ["TARGET_SNAPSHOT"]},
          "dst": {"type": "string"},
          "readonly": {"type": "boolean", "const": true}
        }
      }
    },
    "cmd": {
      "type": "array",
      "minItems": 1,
      "description": "固定 entrypoint：/aegis/entrypoint.py --template <template_id>",
      "items": {"type": "string"}
    },
    "service": {
      "type": "object",
      "required": ["cmd", "port", "wait_for"],
      "additionalProperties": false,
      "properties": {
        "cmd": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "wait_for": {"type": "string"}
      }
    },
    "network": {"type": "string", "enum": ["none", "ssrf-internal"]},
    "nonce": {"type": "string", "description": "runner 產生；prover 事前未知（§17.2）"},
    "timeout_sec": {"type": "integer", "minimum": 1, "maximum": 600},
    "caps": {
      "type": "object",
      "required": ["cpus", "mem", "pids", "cap_drop", "no_new_privileges", "rootfs"],
      "additionalProperties": false,
      "properties": {
        "cpus": {"type": "string"},
        "mem": {"type": "string"},
        "pids": {"type": "integer", "maximum": 128},
        "ulimit_nofile": {"type": "integer"},
        "cap_drop": {"type": "string", "const": "ALL"},
        "no_new_privileges": {"type": "boolean", "const": true},
        "rootfs": {"type": "string", "const": "ro"},
        "user": {"type": "string", "const": "65532:65532"}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "aegis.run_id / aegis.snapshot_id / aegis.kind"
    }
  }
}